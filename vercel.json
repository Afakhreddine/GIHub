{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "fluid": true,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/debug.js":           { "maxDuration": 10  },
    "api/cron-guidelines.js": { "maxDuration": 300 },
    "api/cron-weekly.js":     { "maxDuration": 300 },
    "api/cron-schedule.js":   { "maxDuration": 300 }
  },
  "crons": [
    { "path": "/api/cron-guidelines", "schedule": "0 6 * * 0" },
    { "path": "/api/cron-weekly",     "schedule": "0 8 * * 0" },
    { "path": "/api/cron-schedule",   "schedule": "0 7 * * *" }
  ],
  "rewrites": [
    { "source": "/api/debug",          "destination": "/api/debug" },
    { "source": "/api/claude",          "destination": "/api/claude" },
    { "source": "/api/cron-guidelines", "destination": "/api/cron-guidelines" },
    { "source": "/api/cron-weekly",     "destination": "/api/cron-weekly" },
    { "source": "/api/cron-schedule",   "destination": "/api/cron-schedule" },
    { "source": "/(.*)",                "destination": "/index.html" }
  ]
}
