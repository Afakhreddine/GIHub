{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "fluid": true,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/gihub-auth.js": {
      "maxDuration": 10
    },
    "api/weekly-review-data.js": {
      "maxDuration": 10
    },
    "api/weekly-review-publish.js": {
      "maxDuration": 60
    },
    "api/schedule-review-data.js": {
      "maxDuration": 10
    },
    "api/schedule-review-publish.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/gihub-auth/login",
      "destination": "/api/gihub-auth?action=login"
    },
    {
      "source": "/api/gihub-auth/logout",
      "destination": "/api/gihub-auth?action=logout"
    },
    {
      "source": "/api/gihub-auth/me",
      "destination": "/api/gihub-auth?action=me"
    },
    {
      "source": "/api/gihub-auth/profile",
      "destination": "/api/gihub-auth?action=profile"
    },
    {
      "source": "/api/claude",
      "destination": "/api/claude"
    },
    {
      "source": "/api/weekly-review-data",
      "destination": "/api/weekly-review-data"
    },
    {
      "source": "/api/weekly-review-publish",
      "destination": "/api/weekly-review-publish"
    },
    {
      "source": "/api/schedule-review-data",
      "destination": "/api/schedule-review-data"
    },
    {
      "source": "/api/schedule-review-publish",
      "destination": "/api/schedule-review-publish"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
